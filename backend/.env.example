# Zero-One Backend Environment Configuration Example
# Copy this file to .env and provide your actual secrets locally

# Server Port (default: 3002)
PORT=3002

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zeroone?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here
